rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pgyb41494@gmail.com' ||
        request.auth.token.email == 'cardonayoselin422@gmail.com' ||
        request.auth.token.email == 'Cardonayoselin422@gmail.com'
      );
    }

    function isVerifiedUser() {
      return isAdmin() || isEmailVerified();
    }

    function ownsRequest(data) {
      return data.userId == request.auth.uid || data.uid == request.auth.uid;
    }

    function requestDoc(reqId) {
      return get(/databases/$(database)/documents/requests/$(reqId)).data;
    }

    function canAccessRequest(reqId) {
      return isAdmin() || (isVerifiedUser() && ownsRequest(requestDoc(reqId)));
    }

    function customerAllowedUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['rescheduleDate', 'rescheduleTime', 'rescheduleNote', 'beforePhotos', 'status', 'updatedAt', 'cancelReason']);
    }

    function customerStatusOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || request.resource.data.status == 'cancelled';
    }

    // Users can read/write their own user document
    match /users/{uid} {
      allow read, write: if isVerifiedUser() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Requests
    match /requests/{reqId} {
      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new';

      allow read: if isVerifiedUser() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );

      allow update: if isAdmin()
        || (
          isVerifiedUser()
          && ownsRequest(resource.data)
          && customerAllowedUpdateKeys()
          && customerStatusOk()
          && request.resource.data.userId == resource.data.userId
        );

      allow delete: if isAdmin();
    }

    // Chat messages — only request owner or admin
    match /chats/{reqId}/messages/{msgId} {
      allow read: if canAccessRequest(reqId);

      allow create: if canAccessRequest(reqId)
        && request.resource.data.keys().hasAll(['text', 'sender', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 4000
        && (
          (isAdmin() && request.resource.data.sender == 'admin') ||
          (!isAdmin() && request.resource.data.sender == 'customer')
        );

      allow update, delete: if isAdmin();
    }

    // Chat read receipts — scoped by request access and role suffix
    match /chatReads/{docId} {
      allow read, write: if isVerifiedUser() && (
        isAdmin() ||
        (
          docId.matches('.*_customer$') &&
          canAccessRequest(docId.split('_customer')[0])
        )
      );
    }

    // Chat unread counters
    match /chatUnread/{reqId} {
      allow read, write: if canAccessRequest(reqId);
    }

    // Availability — public read; admin write; customer may delete a held slot
    match /availability/{slotId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/availabilityHolds/$(resource.data.date + '__' + resource.data.time))
        && get(/databases/$(database)/documents/availabilityHolds/$(resource.data.date + '__' + resource.data.time)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/availabilityHolds/$(resource.data.date + '__' + resource.data.time)).data.expiresAt > request.time
      );
    }

    // Slot holds — signed-in verified users can reserve briefly during checkout
    match /availabilityHolds/{holdId} {
      allow read: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.slotKey == holdId
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.holdToken is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      allow update: if isVerifiedUser()
        && (
          isAdmin() ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.holdToken == resource.data.holdToken &&
            request.resource.data.slotKey == resource.data.slotKey &&
            request.resource.data.date == resource.data.date &&
            request.resource.data.time == resource.data.time &&
            request.resource.data.expiresAt is timestamp &&
            request.resource.data.expiresAt > request.time
          )
        );

      allow delete: if isVerifiedUser()
        && (
          isAdmin() ||
          resource.data.userId == request.auth.uid ||
          resource.data.expiresAt <= request.time
        );
    }

    // Recurring schedule
    match /schedule/{entryId} {
      allow read: if isVerifiedUser() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.clientEmail == request.auth.token.email
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isVerifiedUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
    }

    // Settings (pricing, gallery, etc) — admins can write, anyone can read
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — verified users create their own; anyone can read; admin can delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80;
      allow delete: if isAdmin();
    }

    // Gallery photos — admin can write, anyone can read
    match /galleryPhotos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
