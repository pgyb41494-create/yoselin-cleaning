rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pgyb41494@gmail.com'
        || request.auth.token.email == 'cardonayoselin422@gmail.com'
        || request.auth.token.email == 'Cardonayoselin422@gmail.com'
      );
    }

    function isVerified() {
      return isAdmin() || (isSignedIn() && request.auth.token.email_verified == true);
    }

    // Booking photos — owner or admin can read; owner can write
    match /bookings/{userId}/{allPaths=**} {
      allow read: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow write: if isVerified() && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Admin-created bookings use "admin" as the userId folder
    match /bookings/admin/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Gallery photos — admin can upload, anyone can view
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
